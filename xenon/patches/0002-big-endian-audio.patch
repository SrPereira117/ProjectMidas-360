diff --git a/port/src/audio_stubs.c b/port/src/audio_stubs.c
index a871627..fe12990 100644
--- a/port/src/audio_stubs.c
+++ b/port/src/audio_stubs.c
@@ -63,13 +63,22 @@
  * coincide, so both views work off this patch).
  */
 
+/* xenon: em host big-endian os dados da ROM ja estao na ordem certa */
+#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+#define PORT_HOST_BE 1
+#else
+#define PORT_HOST_BE 0
+#endif
+
 static u16 portBSwap16(u16 v)
 {
+    if (PORT_HOST_BE) return v;
     return (u16)((v >> 8) | (v << 8));
 }
 
 static u32 portBSwap32(u32 v)
 {
+    if (PORT_HOST_BE) return v;
     return (v >> 24) | ((v >> 8) & 0xFF00u) | ((v & 0xFF00u) << 8) | (v << 24);
 }
 
