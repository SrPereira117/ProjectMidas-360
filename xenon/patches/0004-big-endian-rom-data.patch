+#ifndef _WIN32
+    {
+        /* Console: every mmap is rounded to 64 KB pages and the title only has ~440 MB, so
+         * hundreds of small never-freed requests (model DL copies, stan packs) used the memory
+         * up and the rest of the game started failing. Bump them from 8 MB chunks instead. */
+        static u8 *chunk;
+        static u32 chunk_used;
+        const u32 CHUNK = 8u * 1024u * 1024u;
+        if (size <= 1024u * 1024u)
+        {
+            if (chunk == NULL || chunk_used + size > CHUNK)
+            {
+                void *c = portAllocHighRaw(NULL, CHUNK);
+                if (c != NULL)
+                {
+                    chunk = (u8 *) c;
+                    chunk_used = 0;
+                    portConLogf("ge: portAllocHigh: new 8 MB chunk at %p\n", c);
+                }
+            }
+            if (chunk != NULL && chunk_used + size <= CHUNK)
+            {
+                void *p = chunk + chunk_used;
+                chunk_used += size;
+                return p;
+            }
+        }
+    }
+#endif
